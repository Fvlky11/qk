# Database — sesuaikan dengan konfigurasi Anda
DB_USER=postgres
DB_HOST=localhost
DB_NAME=catering
DB_PASSWORD=12345678
DB_PORT=5432

# App
PORT=3000
NODE_ENV=development
APP_NAME=Katering App

# JWT — generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=isi_dengan_random_string_minimal_32_karakter
JWT_EXPIRES_IN=7d

# Admin — login admin pakai email & password ini (tidak disimpan di DB)
ADMIN_EMAIL=admin@katering.com
ADMIN_PASSWORD=Admin@2026!

# Upload
MAX_FILE_SIZE=5242880
