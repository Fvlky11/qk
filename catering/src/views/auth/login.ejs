<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="container py-5" style="max-width:440px">
  <div class="card p-4 p-md-5 mt-3">
    <div class="text-center mb-4">
      <i class="bi bi-basket2-fill fs-1" style="color:var(--primary)"></i>
      <h4 class="fw-bold mt-2">Masuk ke Akun Anda</h4>
    </div>

    <% if (registered) { %>
      <div class="alert alert-success small">
        <i class="bi bi-check-circle me-2"></i>Registrasi berhasil! Silakan masuk.
      </div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-danger small">
        <i class="bi bi-exclamation-circle me-2"></i><%= error %>
      </div>
    <% } %>

    <form method="POST" action="/auth/login">
      <div class="mb-3">
        <label class="form-label fw-semibold small">Email</label>
        <input type="email" name="email" class="form-control"
               placeholder="email@anda.com" required autofocus>
      </div>
      <div class="mb-4">
        <label class="form-label fw-semibold small">Password</label>
        <input type="password" name="password" class="form-control"
               placeholder="••••••••" required>
      </div>
      <button type="submit" class="btn btn-primary w-100 fw-semibold py-2">Masuk</button>
    </form>

    <p class="text-center text-muted small mt-4 mb-0">
      Belum punya akun? <a href="/auth/register" style="color:var(--primary)">Daftar sekarang</a>
    </p>
  </div>

  <!-- Demo credentials -->
  <div class="card mt-3 p-3 bg-light border-0">
    <p class="small fw-semibold mb-2 text-muted">Demo akun:</p>
    <div class="small text-muted d-flex flex-column gap-1">
      <div>👑 Admin     : <code>admin@katering.com</code> / <code>Admin@2026!</code></div>
      <div>🛒 Pelanggan : <code>budi@email.com</code> / <code>pelanggan123</code></div>
      <div>🚚 Kurir     : <code>eko@katering.com</code> / <code>kurir123</code></div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
