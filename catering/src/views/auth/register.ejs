<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="container py-5" style="max-width:520px">
  <div class="card p-4 p-md-5 mt-3">
    <div class="text-center mb-4">
      <i class="bi bi-person-plus-fill fs-1" style="color:var(--primary)"></i>
      <h4 class="fw-bold mt-2">Buat Akun Baru</h4>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger small"><i class="bi bi-exclamation-circle me-2"></i><%= error %></div>
    <% } %>

    <form method="POST" action="/auth/register">
      <div class="row g-3">
        <div class="col-12">
          <label class="form-label fw-semibold small">Nama Lengkap</label>
          <input type="text" name="nama" class="form-control" placeholder="Nama Anda" required>
        </div>
        <div class="col-12">
          <label class="form-label fw-semibold small">Email</label>
          <input type="email" name="email" class="form-control" placeholder="email@anda.com" required>
        </div>
        <div class="col-md-6">
          <label class="form-label fw-semibold small">No. HP / WhatsApp</label>
          <input type="text" name="no_hp" class="form-control" placeholder="08xxxxxxxxxx" required>
        </div>
        <div class="col-md-6">
          <label class="form-label fw-semibold small">Kota</label>
          <input type="text" name="kota" class="form-control" placeholder="Yogyakarta">
        </div>
        <div class="col-12">
          <label class="form-label fw-semibold small">Alamat</label>
          <textarea name="alamat" class="form-control" rows="2" placeholder="Jl. ..."></textarea>
        </div>
        <div class="col-12">
          <label class="form-label fw-semibold small">Password</label>
          <input type="password" name="password" class="form-control" placeholder="Min. 8 karakter" required minlength="8">
        </div>
        <div class="col-12">
          <button type="submit" class="btn btn-primary w-100 fw-semibold py-2">Daftar Sekarang</button>
        </div>
      </div>
    </form>

    <p class="text-center text-muted small mt-4 mb-0">
      Sudah punya akun? <a href="/auth/login" style="color:var(--primary)">Masuk</a>
    </p>
  </div>
</div>
<%- include('../partials/footer') %>
