<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">Pesanan Saya</h4>
    <a href="/pemesanan/buat" class="btn btn-primary btn-sm px-3">
      <i class="bi bi-plus-circle me-1"></i>Pesan Baru
    </a>
  </div>

  <% if (!pesanan.length) { %>
  <div class="card p-5 text-center">
    <i class="bi bi-bag-x fs-1 text-muted mb-3 d-block"></i>
    <h5 class="text-muted">Belum ada pesanan</h5>
    <a href="/pemesanan/buat" class="btn btn-primary mt-3">Buat Pesanan Pertama</a>
  </div>
  <% } %>

  <div class="d-flex flex-column gap-3">
  <% pesanan.forEach(p => {
    const s = statusLabel[p.status]||{text:p.status,class:'secondary'};
    const sisa = parseFloat(p.total_harga) - parseFloat(p.total_dibayar||0);
  %>
  <div class="card p-4">
    <div class="row align-items-center">
      <div class="col-md-8">
        <div class="d-flex align-items-center gap-2 mb-1">
          <span class="fw-bold"><%= p.nomor_pesanan %></span>
          <span class="badge bg-<%= s.class %>"><%= s.text %></span>
          <!-- Notif aksi yang perlu dilakukan -->
          <% if (p.status === 'dikonfirmasi' && sisa > 0) { %>
            <span class="badge bg-warning text-dark"><i class="bi bi-exclamation me-1"></i>Perlu Bayar</span>
          <% } %>
          <% if (p.status === 'sedang_dikirim') { %>
            <span class="badge bg-success"><i class="bi bi-truck me-1"></i>Sedang Dikirim</span>
          <% } %>
        </div>
        <div class="text-muted small mb-1">
          <i class="bi bi-box-seam me-1"></i><%= p.nama_paket %> &bull;
          <i class="bi bi-people me-1 ms-1"></i><%= p.jumlah_porsi %> porsi &bull;
          <i class="bi bi-calendar me-1 ms-1"></i><%= formatTanggal(p.tanggal_acara) %>
        </div>
      </div>
      <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <div class="fw-bold fs-5"><%= formatRupiah(p.total_harga) %></div>
        <% if (sisa > 0) { %>
          <div class="text-danger small">Sisa: <%= formatRupiah(sisa) %></div>
        <% } else { %>
          <div class="text-success small"><i class="bi bi-check-circle me-1"></i>Lunas</div>
        <% } %>
        <a href="/pemesanan/<%= p.id %>" class="btn btn-sm btn-outline-primary mt-2">Detail</a>
      </div>
    </div>
  </div>
  <% }) %>
  </div>
</div>
<%- include('../partials/footer') %>
