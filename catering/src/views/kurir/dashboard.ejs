<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="container py-4">

  <div class="d-flex align-items-center gap-3 mb-4">
    <i class="bi bi-truck fs-2" style="color:var(--primary)"></i>
    <div>
      <h4 class="fw-bold mb-0">Dashboard Kurir</h4>
      <div class="text-muted small"><%= user.nama %></div>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-6">
      <div class="card p-3 text-center" style="border-top:3px solid var(--primary)">
        <div class="fs-2 fw-bold"><%= stats.aktif %></div>
        <div class="text-muted small">Tugas Aktif</div>
      </div>
    </div>
    <div class="col-6">
      <div class="card p-3 text-center" style="border-top:3px solid #198754">
        <div class="fs-2 fw-bold"><%= stats.selesai %></div>
        <div class="text-muted small">Selesai Dikirim</div>
      </div>
    </div>
  </div>

  <h5 class="fw-bold mb-3">Tugas Pengiriman</h5>

  <% if (!tugas.length) { %>
    <div class="card p-5 text-center">
      <i class="bi bi-truck fs-1 text-muted mb-3 d-block"></i>
      <h5 class="text-muted">Belum ada tugas pengiriman</h5>
    </div>
  <% } %>

  <div class="d-flex flex-column gap-3">
  <% tugas.forEach(t => {
    const selesai = ['selesai','gagal'].includes(t.status);
    const spText = {
      kurir_ditugaskan:'Ditugaskan — Belum Diambil',
      dalam_perjalanan:'Sedang Dikirim',
      selesai:'Selesai', gagal:'Gagal'
    }[t.status] || t.status;
    const spClass = {
      kurir_ditugaskan:'warning', dalam_perjalanan:'primary',
      selesai:'success', gagal:'danger'
    }[t.status] || 'secondary';
  %>
  <div class="card p-4">
    <div class="row g-3">
      <div class="col-md-7">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="fw-bold"><%= t.nomor_pesanan %></span>
          <span class="badge bg-<%= spClass %>"><%= spText %></span>
        </div>
        <table class="table table-sm table-borderless small mb-0">
          <tr><td class="text-muted" width="110">Pelanggan</td><td><strong><%= t.nama_pelanggan %></strong> · <%= t.hp_pelanggan %></td></tr>
          <tr><td class="text-muted">Paket</td><td><%= t.nama_paket %> · <%= t.jumlah_porsi %> porsi</td></tr>
          <tr><td class="text-muted">Tgl Acara</td><td><strong><%= formatTanggal(t.tanggal_acara) %></strong></td></tr>
          <tr><td class="text-muted">Lokasi</td><td><%= t.lokasi_acara %><%= t.kota_acara?', '+t.kota_acara:'' %></td></tr>
        </table>
        <% if (t.bukti_foto) { %>
          <p class="small fw-semibold mt-2 mb-1">Bukti Pengiriman:</p>
          <img src="<%= t.bukti_foto %>" class="img-thumbnail" style="max-height:120px">
        <% } %>
      </div>

      <div class="col-md-5">
        <% if (!selesai) { %>
          <% if (t.status === 'kurir_ditugaskan') { %>
            <!-- STEP 5: Kurir ambil tugas -->
            <div class="alert alert-warning small mb-2">
              <i class="bi bi-bell me-1"></i>Ada tugas pengiriman untuk Anda!
            </div>
            <form method="POST" action="/kurir/pengiriman/<%= t.id %>/ambil">
              <button class="btn btn-primary w-100 fw-semibold">
                <i class="bi bi-truck me-1"></i>Ambil Tugas — Mulai Antar
              </button>
            </form>
          <% } %>

          <% if (t.status === 'dalam_perjalanan') { %>
            <!-- Update lokasi -->
            <form method="POST" action="/kurir/pengiriman/<%= t.id %>/update" class="mb-3">
              <input type="hidden" name="status" value="dalam_perjalanan">
              <label class="form-label small fw-semibold">Update Lokasi Terkini</label>
              <div class="input-group input-group-sm">
                <input type="text" name="lokasi_terkini" class="form-control" placeholder="Jl. Malioboro...">
                <button class="btn btn-outline-primary">Update</button>
              </div>
            </form>

            <!-- Selesai antar + upload bukti -->
            <form method="POST" action="/kurir/pengiriman/<%= t.id %>/update" enctype="multipart/form-data">
              <input type="hidden" name="status" value="selesai">
              <label class="form-label small fw-semibold">Upload Bukti Pengiriman *</label>
              <input type="file" name="bukti_foto" class="form-control form-control-sm mb-2" accept="image/*" required>
              <textarea name="catatan_kurir" class="form-control form-control-sm mb-2" rows="2"
                        placeholder="Catatan pengiriman (opsional)"></textarea>
              <button class="btn btn-success w-100">
                <i class="bi bi-check2-circle me-1"></i>Selesai Diantar
              </button>
            </form>
          <% } %>
        <% } else { %>
          <div class="text-center py-3">
            <i class="bi bi-check-circle-fill fs-2 text-<%= t.status==='selesai'?'success':'danger' %> d-block mb-2"></i>
            <p class="small text-muted">
              <%= t.status==='selesai'
                ? 'Pengiriman selesai. Menunggu konfirmasi pelanggan.'
                : 'Pengiriman gagal.' %>
            </p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
  <% }) %>
  </div>
</div>
<%- include('../partials/footer') %>
