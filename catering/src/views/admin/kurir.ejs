<%- include('../partials/head') %>
<div class="d-flex">
  <%- include('../partials/sidebar-admin') %>
  <div class="flex-grow-1">
    <%- include('../partials/navbar') %>
    <div class="container-fluid p-4">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">Kelola Kurir</h4>
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalTambahKurir">
          <i class="bi bi-plus-circle me-1"></i>Tambah Kurir
        </button>
      </div>

      <div class="row g-3">
        <% kurir.forEach(k => { %>
        <div class="col-md-4">
          <div class="card p-4 h-100">
            <div class="d-flex align-items-center gap-3 mb-3">
              <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white"
                   style="width:48px;height:48px;background:var(--primary);font-size:1.2rem">
                <%= k.nama.charAt(0).toUpperCase() %>
              </div>
              <div>
                <div class="fw-bold"><%= k.nama %></div>
                <div class="text-muted small"><%= k.email %></div>
              </div>
              <span class="badge ms-auto bg-<%= k.aktif ? 'success' : 'secondary' %>">
                <%= k.aktif ? 'Aktif' : 'Nonaktif' %>
              </span>
            </div>
            <table class="table table-sm table-borderless small mb-0">
              <tr><td class="text-muted">No. HP</td><td><%= k.no_hp %></td></tr>
              <tr><td class="text-muted">Kendaraan</td><td><%= k.kendaraan || '—' %></td></tr>
              <tr><td class="text-muted">No. Plat</td><td><%= k.no_plat || '—' %></td></tr>
              <tr><td class="text-muted">Total Kirim</td><td><strong><%= k.total_pengiriman %></strong> pesanan</td></tr>
            </table>
          </div>
        </div>
        <% }) %>

        <% if (kurir.length === 0) { %>
        <div class="col-12">
          <div class="card p-5 text-center">
            <i class="bi bi-truck fs-1 text-muted mb-3"></i>
            <h5 class="text-muted">Belum ada kurir terdaftar</h5>
          </div>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Modal Tambah Kurir -->
<div class="modal fade" id="modalTambahKurir" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/admin/kurir">
        <div class="modal-header">
          <h6 class="modal-title fw-bold">Tambah Kurir Baru</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-12"><label class="form-label small fw-semibold">Nama Lengkap</label>
              <input type="text" name="nama" class="form-control" required></div>
            <div class="col-md-6"><label class="form-label small fw-semibold">Email</label>
              <input type="email" name="email" class="form-control" required></div>
            <div class="col-md-6"><label class="form-label small fw-semibold">No. HP</label>
              <input type="text" name="no_hp" class="form-control" required></div>
            <div class="col-md-6"><label class="form-label small fw-semibold">Password</label>
              <input type="password" name="password" class="form-control" required minlength="8"></div>
            <div class="col-md-6"><label class="form-label small fw-semibold">Kendaraan</label>
              <input type="text" name="kendaraan" class="form-control" placeholder="Pickup Bak"></div>
            <div class="col-md-6"><label class="form-label small fw-semibold">No. Plat</label>
              <input type="text" name="no_plat" class="form-control" placeholder="AB 1234 CD"></div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
          <button type="submit" class="btn btn-primary btn-sm">Simpan</button>
        </div>
      </form>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
